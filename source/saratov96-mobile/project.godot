; Saratov '96 GO mobile-first rebuild
config_version=5

[application]
config/name="Саратов ’96 GO"
run/main_scene="res://scenes/main.tscn"

[autoload]
AudioManager="*res://scripts/audio_manager.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.039, 1)
